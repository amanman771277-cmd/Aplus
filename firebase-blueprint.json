{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "User's role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "displayName": {
          "type": "string",
          "description": "User's display name"
        },
        "bio": {
          "type": "string",
          "description": "User's bio"
        }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Quote": {
      "title": "Quote",
      "description": "A motivational quote",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The motivational quote text"
        },
        "author": {
          "type": "string",
          "description": "The author of the quote (usually the admin)"
        },
        "category": {
          "type": "string",
          "description": "Optional category for the quote"
        },
        "status": {
          "type": "string",
          "enum": ["published", "draft", "rejected"],
          "description": "Status of the quote"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the admin who created it"
        }
      },
      "required": ["text", "author", "createdAt", "createdBy"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "A user's favorite quote reference",
      "type": "object",
      "properties": {
        "quoteId": {
          "type": "string",
          "description": "The ID of the favorited quote"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["quoteId", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A system notification for users",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Notification title"
        },
        "message": {
          "type": "string",
          "description": "Notification message"
        },
        "type": {
          "type": "string",
          "enum": ["quote", "system"],
          "description": "Type of notification"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "link": {
          "type": "string",
          "description": "Optional link for the notification"
        }
      },
      "required": ["title", "message", "type", "createdAt"]
    }
  },
  "firestore": {
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Stores global system notifications"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and roles"
    },
    "/users/{userId}/favorites/{quoteId}": {
      "schema": { "$ref": "#/entities/Favorite" },
      "description": "Stores a user's favorite quotes"
    },
    "/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/Quote" },
      "description": "Stores motivational quotes"
    },
    "/users/{userId}/fcm_tokens/{tokenId}": {
      "schema": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["token", "createdAt"]
      },
      "description": "Stores user FCM tokens for push notifications"
    }
  }
}
